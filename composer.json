{
  "name": "erikwang2013/aetherupload-webman",
  "description": "AetherUpload for webman and six more frameworks: chunked large-file upload with resumable transfer, instant upload (sec秒传) and integrity check. Framework-agnostic kernel with adapters for webman, Laravel, ThinkPHP, Symfony, Slim, Hyperf and Yii2.",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "erik",
      "email": "erik@erik.xyz",
      "homepage": "https://erik.xyz",
      "role": "Developer"
    }
  ],
  "keywords": [
    "erik",
    "erikwang2013",
    "aetherupload",
    "webman",
    "laravel",
    "thinkphp",
    "symfony",
    "slim",
    "hyperf",
    "yii",
    "大文件",
    "large",
    "chunked-upload",
    "resumable-upload",
    "upload"
  ],
  "support": {
    "email": "erik@erik.xyz",
    "issues": "https://github.com/erikwang2013/aetherupload-webman/issues",
    "source": "https://github.com/erikwang2013/aetherupload-webman"
  },
  "require": {
    "php": "^8.0",
    "symfony/translation": "^5.4 || ^6.0 || ^7.0",
    "webman/event": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "AetherUpload\\": "src"
    },
    "files": [ "src/helpers.php" ]
  },
  "autoload-dev": {
    "psr-4": {
      "AetherUpload\\Tests\\": "tests/"
    },
    "classmap": [ "tests/Stubs" ]
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5",
    "symfony/console": "^6.0 || ^7.0",
    "webman/console": "^1.0 || ^2.1.7"
  },
  "repositories": {
    "packagist": {
      "type": "composer",
      "url": "https://repo.packagist.org/"
    }
  },
  "suggest": {
    "predis/predis": "开启秒传（instant_completion）所需；未安装时秒传不可用，其余功能不受影响",
    "webman/console": "webman 下运行 aetherupload:groups / :build / :clean 三个控制台命令所需（webman 应用的 CLI 本身即由它提供）"
  }
}
