{
    "name": "aetherupload/symfony-e2e-app",
    "description": "Symfony 端到端测试用的最小应用骨架（由 tests/Integration/symfony/App.php 复制到临时目录后再装依赖）",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.0",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "symfony/browser-kit": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
